# Copy values into the hosting provider's PRIVATE environment settings.
# Do not put a real API key in HTML, GitHub, this example, or chat.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us13
MAILCHIMP_LIST_ID=1a86cc1618
NEWSLETTER_ALLOWED_ORIGINS=https://themarginsjournals.com,https://www.themarginsjournals.com
# Enable only after configuring and activating the event-triggered welcome flow.
NEWSLETTER_ENABLED=false

# Persistent article page views. Upstash for Redis can provision these through
# the Vercel Storage / Marketplace screen. The KV_REST_API_URL / TOKEN names
# provisioned by that integration are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VIEWS_ALLOWED_ORIGINS=https://themarginsjournals.com,https://www.themarginsjournals.com

# Field Notes accounts, submissions and interactions. Configure a Supabase
# project using COMMUNITY-SETUP.md before enabling. Never commit real keys.
COMMUNITY_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
