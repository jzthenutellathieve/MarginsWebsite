{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/community.js": {
      "maxDuration": 30,
      "includeFiles": "content/field-notes/*.json"
    },
    "api/newsletter.js": {
      "maxDuration": 30
    },
    "api/views.js": {
      "maxDuration": 10,
      "includeFiles": "content/articles/*.json"
    }
  },
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/articles/page/:page",
      "destination": "/articles/",
      "permanent": true
    },
    {
      "source": "/articles/topic/:topic/page/:page",
      "destination": "/articles/topic/:topic/",
      "permanent": true
    },
    {
      "source": "/reporting/:slug",
      "destination": "/articles/:slug/",
      "permanent": true
    },
    {
      "source": "/reporting",
      "destination": "/articles/",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/water",
      "destination": "/projects/water/",
      "permanent": true
    },
    {
      "source": "/housing",
      "destination": "/projects/housing/",
      "permanent": true
    },
    {
      "source": "/articles/topic/:topic",
      "destination": "/articles/",
      "permanent": true
    }
  ]
}
